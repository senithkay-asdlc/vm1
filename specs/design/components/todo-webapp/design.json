{
  "name": "todo-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "todo-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6
  ],
  "description": "The single-page app a user signs into to manage their own todo list: add a todo, edit a pending one's text, and mark one done. Carries no business logic and no data of its own — everything is read from and written to todo-api. Does not support editing a todo once it is marked done, and does not support deleting a todo.",
  "dependencies": [
    {
      "kind": "component",
      "name": "todo-api",
      "description": "Lists, creates, and completes the signed-in user's todos.",
      "wiring": {
        "endpoint": {
          "component": "vm1-todo-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TODO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "vm1-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
