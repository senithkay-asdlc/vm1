{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    3,
    4,
    5,
    6
  ],
  "description": "Owns the Todo entity: lets the signed-in caller list their own todos, add a new one, edit a pending one's text, and mark one as done. Persists todos in its dedicated Postgres database, scoped per caller by the gateway-asserted identity. Locks a todo's text once it is marked done, does not support deleting a todo, and never exposes another user's todos.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "vm1-todo-db",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "vm1-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
