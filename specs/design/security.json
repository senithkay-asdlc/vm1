{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A user's own todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "create", "description": "Add a new todo to the caller's list" },
        { "handle": "complete", "description": "Mark one of the caller's todos as done" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "User",
      "description": "Signs up, signs in, and manages their own private list of todos.",
      "stories": [1, 2, 3, 4, 5],
      "grants": ["todos:read", "todos:create", "todos:complete"],
      "enrolment": "self-service"
    }
  ],
  "testUsers": [
    { "username": "test-user-1", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
